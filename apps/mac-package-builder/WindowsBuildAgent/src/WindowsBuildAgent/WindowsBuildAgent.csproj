<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      Targets net8.0-windows because AuthenticodeService relies on
      WinVerifyTrust (wintrust.dll) and System.Management/COM interop for
      MSI inspection, which are Windows-only. The agent is only ever meant
      to run on the Windows host doing the packaging work; it is not meant
      to build or run on macOS/Linux. Services that are conceptually
      cross-platform (JobStore, PathValidationService, WinGet argument
      building) still guard themselves with runtime OS checks so the
      *logic* can be unit tested on any OS that has the .NET 8 SDK, even
      though the full app only ships for Windows.
    -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WindowsBuildAgent</RootNamespace>
    <AssemblyName>WindowsBuildAgent</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseWindowsForms>false</UseWindowsForms>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <WarningsAsErrors>Nullable</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Grants the test project access to internal members (e.g.
      JobStore.SweepExpiredJobs, WinGetService.ValidatePackageId,
      WinGetService.ParseSearchOutput/ParseShowOutput,
      AuthenticodeService.ClassifyTrustResult and its HRESULT constants) so
      pure logic can be unit tested directly without making it public API
      surface or invoking the real Win32/process calls it wraps.
    -->
    <InternalsVisibleTo Include="WindowsBuildAgent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
