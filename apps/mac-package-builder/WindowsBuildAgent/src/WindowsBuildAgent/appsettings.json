{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://0.0.0.0:8443",
        "Certificate": {
          "Path": "C:\\ProgramData\\WindowsBuildAgent\\certs\\agent.pfx",
          "Password": "__SET_VIA_ENVIRONMENT_OR_SECRET_STORE__"
        }
      }
    },
    "Limits": {
      "MaxRequestBodySize": 5242880,
      "MaxConcurrentConnections": 100,
      "MaxConcurrentUpgradedConnections": 100,
      "RequestHeadersTimeout": "00:00:30",
      "KeepAliveTimeout": "00:02:00"
    }
  },

  "AgentAuth": {
    "_comment": "API key hash (SHA-256, hex, lowercase) of the shared secret the Mac client presents as a bearer token. Never store the plaintext key here. Generate with: agent-cli hash-key. Optionally DPAPI-protect this file at rest.",
    "ApiKeyHashHex": "__REPLACE_WITH_SHA256_HEX_OF_API_KEY__",
    "ApiKeyHeaderName": "Authorization",
    "ApiKeyHeaderScheme": "Bearer"
  },

  "AgentInfo": {
    "AgentName": "WINDOWS-BUILD-01"
  },

  "WinGet": {
    "ExecutablePath": "C:\\Users\\Default\\AppData\\Local\\Microsoft\\WindowsApps\\winget.exe",
    "ProcessTimeoutSeconds": 120
  },

  "IntuneWinAppUtil": {
    "_comment": "Admin-approved path to the packaged IntuneWinAppUtil.exe. Must live outside any job/source working directory.",
    "ExecutablePath": "C:\\ProgramData\\WindowsBuildAgent\\tools\\IntuneWinAppUtil.exe",
    "ProcessTimeoutSeconds": 600
  },

  "Packager": {
    "_comment": "ITO Windows Package Builder worker. AllowedServerHost is the ONLY host the worker fetches sources from / uploads packages to. Run this agent on a disposable VM: validation really installs the uploaded software.",
    "AllowedServerHost": "__ITO_SERVER_HOSTNAME__",
    "MaxSourceBytes": 32212254720,
    "StepTimeoutMinutes": 30,
    "MaxConcurrent": 1
  },

  "JobStore": {
    "RootDirectory": "C:\\ProgramData\\WindowsBuildAgent\\jobs",
    "MaxConcurrentJobs": 3,
    "JobTimeoutMinutes": 30,
    "ArtifactRetentionHours": 24,
    "SweepIntervalMinutes": 15
  }
}
