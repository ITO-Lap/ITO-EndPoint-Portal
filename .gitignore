# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Server compiled output
server/dist
server/node_modules

# Environment files — never commit real secrets
.env
.env.*
!.env.example
!server/.env.example

# Certificates / private keys — never commit real secrets
*.pem
*.key

# Runtime-persisted integration credentials (written by the backend on save)
server/.integration-credentials.json
server/.app-release-alerts.json
server/.patch-remediation-actions.json
server/.scheduled-reports.json
server/.fleet-snapshots.json
server/.notifications.json
server/.rbac.json
server/.session-secret

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.claude/

# Endpoint Central app-inventory scan cache
server/.cache

# Runtime data folder (DATA_DIR default for local development)
server/data/

# The mirrored macOS project (apps/mac-package-builder) includes the Windows agent solution file
!apps/mac-package-builder/**/*.sln
