<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS site config for EndPoint+.

  This site does NOT run Node — it reverse-proxies every request to the
  Express process (frontend + API, single process) running on
  http://127.0.0.1:4000, started independently as a Windows Service.

  Requires on the IIS server:
    - URL Rewrite module      https://www.iis.net/downloads/microsoft/url-rewrite
    - Application Request Routing (ARR)  https://www.iis.net/downloads/microsoft/application-request-routing
    - ARR proxy enabled once, server-wide:
        IIS Manager → server node → Application Request Routing Cache
        → Server Proxy Settings... → check "Enable proxy" → Apply

  Copy this file to the IIS site's physical path root (the folder bound to
  the site in IIS Manager). It does not need to be inside the repo checkout.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ReverseProxyToNode" stopProcessing="true">
          <match url="(.*)" />
          <!-- Tell Express the address the browser used, so Microsoft sign-in returns to this site. Needs
               HTTP_X_FORWARDED_HOST and HTTP_X_FORWARDED_PROTO added to URL Rewrite's allowed server variables
               (IIS Manager → site → URL Rewrite → View Server Variables…). Alternatively set AUTH_REDIRECT_URI
               and FRONTEND_URL in server\.env. Change "https" if the site is served over plain http. -->
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:4000/{R:1}" logRewrittenUrl="true" />
        </rule>
      </rules>
    </rewrite>

    <!-- Node's own error handler returns JSON; let it through as-is. -->
    <httpErrors existingResponse="PassThrough" />

    <!-- Static assets are served by Express (dist/), not IIS — don't double-serve. -->
    <staticContent>
      <remove fileExtension=".json" />
    </staticContent>

    <security>
      <requestFiltering>
        <!-- Raise if audit-log CSV exports or file uploads exceed 30MB. -->
        <requestLimits maxAllowedContentLength="30000000" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
