# Server
PORT=4000

# OpenAI (key format: sk-...)
OPENAI_API_KEY=

# Google Gemini — Endpoint Operations Copilot (Google AI Studio key, AIza...)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set false to prevent all public-web Google Search grounding.
GEMINI_ENABLE_GOOGLE_SEARCH=true

# Microsoft Intune (Azure AD App Registration)
INTUNE_TENANT_ID=
INTUNE_CLIENT_ID=
INTUNE_CLIENT_SECRET=

# Microsoft Entra ID (optional — falls back to Intune credentials if not set)
# Requires AuditLog.Read.All, Directory.Read.All, IdentityRiskyUser.Read.All,
# Reports.Read.All on the Azure AD App Registration
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# This app has no per-user login — the Profile page shows real Entra ID +
# Intune data for one fixed identity, looked up by UPN/email via app-only
# Graph credentials. Defaults to avinash.verma@zinnia.com if unset.
PROFILE_USER_UPN=avinash.verma@zinnia.com

# ManageEngine MDM On-Demand (Endpoint Central Cloud) — Zoho OAuth2 self-client,
# scope MDMOnDemand.MDMInventory.READ
MANAGEENGINE_CLIENT_ID=
MANAGEENGINE_CLIENT_SECRET=
MANAGEENGINE_REFRESH_TOKEN=
MANAGEENGINE_API_DOMAIN=https://mdm.manageengine.com
# Patch Manager API host (needs DesktopCentralCloud.PatchMgmt.READ on the same OAuth client).
# ENDPOINT_CENTRAL_BASE_URL=https://endpointcentral.manageengine.com

# Slack (api.slack.com/apps — scopes: auditlogs:read, channels:read, users:read — bot token format: xoxb-...)
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=
SLACK_CRITICAL_PATCH_CHANNEL_ID=
# Slack channel for verified Windows/macOS application-release alerts. Falls
# back to SLACK_CRITICAL_PATCH_CHANNEL_ID when unset.
SLACK_APP_UPDATE_CHANNEL_ID=
# How often to re-check approved app-version sources for release alerts.
# Default: 6 hours. The first check establishes a baseline and does not alert.
APP_INTEL_RELEASE_POLL_INTERVAL_MS=21600000
# Slack release notices are aggregated and delivered no more than once per week.
APP_INTEL_RELEASE_ALERT_INTERVAL_MS=604800000
SLACK_SIGNING_SECRET=
SLACK_WORKSPACE_ID=

# Jira (Atlassian Cloud — Settings → Security → API tokens)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Confluence (optional — defaults to JIRA_BASE_URL if the same Atlassian instance)
CONFLUENCE_BASE_URL=

# ── Intelligence Platform ──────────────────────────────────────────────────────
# PostgreSQL — required for multi-tenant, audit log, and scheduled reports.
# Without this set, those features degrade gracefully; all Intune/AI features still work.
# Connection string components: scheme (postgresql), user, password, host, port, database name.
# Get the assembled value from your database provider's dashboard — do not hand-write one here.
DATABASE_URL=

# Initialise schema after setting DATABASE_URL:
#   psql $DATABASE_URL -f server/src/db/schema.sql

# Install export packages (PDF/Excel/PPTX — CSV works without them):
#   cd server && npm install exceljs pdfkit pptxgenjs
#   npm install -D @types/pdfkit @types/node-cron

# ── Intune Audit Logs module ────────────────────────────────────────────────────
# Reads Microsoft Graph v1.0 GET /deviceManagement/auditEvents. Requires
# PostgreSQL (DATABASE_URL above) for durable/resumable exports, schedules,
# and the application audit trail — without it the events browser still
# works, but export/schedule endpoints return 503.
#
# Required Graph application permission (least-privileged that covers the
# full auditEvents surface, not just app-management events):
#   DeviceManagementConfiguration.Read.All
# (DeviceManagementApps.Read.All alone only surfaces app-category audit
# events — do not use it if you need every category.)

# Graph auth mode for this module: client_secret (default, reuses
# INTUNE_TENANT_ID/CLIENT_ID/CLIENT_SECRET above) | certificate | managed_identity
INTUNE_AUDIT_AUTH_MODE=client_secret

# Certificate-based app-only auth (used when INTUNE_AUDIT_AUTH_MODE=certificate).
# INTUNE_AUDIT_CERT_PEM holds the PEM-encoded private key + cert chain contents
# directly (e.g. from Key Vault) — prefer this over a filesystem path in
# containerized/App Service hosting.
INTUNE_AUDIT_CERT_PEM=
INTUNE_AUDIT_CERT_THUMBPRINT=

# Managed Identity auth (used when INTUNE_AUDIT_AUTH_MODE=managed_identity;
# requires hosting on Azure App Service/Container Apps/VM with a system- or
# user-assigned identity granted the Graph application permission above).
# Leave blank to use the system-assigned identity.
INTUNE_AUDIT_MANAGED_IDENTITY_CLIENT_ID=

# Chunking / range limits — server-side, cannot be overridden by the client.
INTUNE_AUDIT_CHUNK_DAYS=7
INTUNE_AUDIT_MAX_RANGE_DAYS=366
INTUNE_AUDIT_MAX_CONCURRENT_CHUNKS=1
INTUNE_AUDIT_DEFAULT_TIMEZONE=UTC

# Azure Blob Storage for completed exports. Prefer Managed Identity
# (INTUNE_AUDIT_STORAGE_ACCOUNT_URL, e.g. https://<account>.blob.core.windows.net)
# over a connection string. Container is created private (no public access)
# on first use if it doesn't already exist.
INTUNE_AUDIT_STORAGE_ACCOUNT_URL=
INTUNE_AUDIT_STORAGE_CONNECTION_STRING=
INTUNE_AUDIT_STORAGE_CONTAINER=intune-audit-exports
# Subscription/resource group are informational only — set for documentation
# and Bicep/Terraform provisioning; the app talks to Blob Storage directly
# via the URL/connection string above, never via ARM.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
# Dev-only local-disk fallback when neither storage option above is set.
# Automatically disabled when NODE_ENV=production.
INTUNE_AUDIT_LOCAL_STORAGE_DIR=./.intune-audit-exports-dev

# Email delivery of completed exports — sent server-side via Microsoft Graph
# sendMail from a designated service mailbox (app-only permission Mail.Send,
# scoped via application access policy to that one mailbox — do not grant
# tenant-wide Mail.Send). Falls back to a no-op logger when unset.
INTUNE_AUDIT_EMAIL_SENDER_UPN=
INTUNE_AUDIT_EMAIL_ALLOWED_DOMAINS=zinnia.com
INTUNE_AUDIT_EMAIL_DEFAULT_RECIPIENT=
INTUNE_AUDIT_EMAIL_ATTACHMENT_MAX_MB=20
INTUNE_AUDIT_EMAIL_LINK_TTL_MINUTES=30

# Hosting environment — informational, used only in log lines / docs to
# note which managed-identity binding applies (App Service vs Container Apps).
INTUNE_AUDIT_HOSTING_ENV=

# Recurring export schedules — in-process node-cron ticking on this interval
# (seconds), claiming due schedules from PostgreSQL. Not an in-memory
# scheduler: state lives in intune_audit_export_schedules, so a restart never
# loses a schedule, only the in-flight tick.
INTUNE_AUDIT_SCHEDULER_POLL_SECONDS=60
# NOTE: the tables/scheduler above back the OLD "Intune Audit Logs" feature.
# Its routes have been removed (superseded by the Role Activity Backup
# module below); the scheduler is no longer started from index.ts, so these
# vars now only matter if you re-wire that module back in.

# ── Role Activity Backup module ─────────────────────────────────────────────────
# Live-browses admin role-management/RBAC/permission-change activity from
# three Microsoft sources — Entra ID role management (Graph directoryAudits),
# Intune RBAC (Graph deviceManagement/auditEvents), and SharePoint
# site-collection-admin/permission changes (O365 Management Activity API) —
# on each GET /api/role-activity/events request. No database is used by this
# module: nothing is persisted, deduped, or watermarked between requests: the
# three sources are queried fresh, in parallel, for the requested range every
# time. Export/download is a client-side (frontend) concern, not a backend
# route.
#
# Graph-based pullers (Entra, Intune) reuse INTUNE_TENANT_ID/CLIENT_ID/
# CLIENT_SECRET (and INTUNE_AUDIT_AUTH_MODE / cert / managed-identity vars
# above) via the same auth module as the old Intune Audit Logs feature.
# Required Graph application permissions: AuditLog.Read.All (Entra puller),
# DeviceManagementConfiguration.Read.All (Intune puller).
#
# The SharePoint puller uses the O365 Management Activity API instead of
# Graph — different resource/audience (https://manage.office.com) — but
# reuses the same ENTRA_TENANT_ID/CLIENT_ID/CLIENT_SECRET credentials above
# (falling back to INTUNE_* if ENTRA_* is unset, same as entraIntelligence.ts).
# Required Azure AD app permission: Office 365 Management APIs →
# ActivityFeed.Read (Application). No separate tenant-domain env var is
# needed — ENTRA_TENANT_ID is sufficient for the {tenantId} path segment in
# manage.office.com URLs.
# UNVALIDATED against a live tenant — see sharepointRoleActivityPuller.ts.

# ── Security Policies module ────────────────────────────────────────────────────
# Captures live Intune device-management policies and Entra ID identity/
# security policies, normalizes them, and stores dated snapshots so the
# latest two syncs can be diffed (added/modified/removed). No new env vars —
# reuses INTUNE_TENANT_ID/CLIENT_ID/CLIENT_SECRET (and/or ENTRA_* — either
# integration alone is enough; each side's categories are independent) and
# DATABASE_URL above (schema: security_policy_sync_runs, _snapshots,
# _changes, _group_cache — see schema.sql). Without DATABASE_URL, /sync
# returns 503 and list/detail endpoints report configured:false.
#
# Additional Graph application permissions required on the same app
# registration (beyond what Intune/Entra already need elsewhere):
#   DeviceManagementConfiguration.Read.All    — configurationPolicies, deviceConfigurations,
#                                                deviceCompliancePolicies, intents (legacy baselines)
#   DeviceManagementEndpointSecurity.Read.All — endpoint security intents
#   Policy.Read.All                           — conditionalAccess policies/namedLocations,
#                                                authorizationPolicy, authenticationStrengthPolicies,
#                                                identitySecurityDefaultsEnforcementPolicy
#   Policy.Read.AuthenticationMethod           — authenticationMethodsPolicy
#   Group.Read.All                             — resolve assignment target group ids to names
# See docs/04-integrations/SECURITY-POLICIES.md.

# Max span (days) a single live-browse GET /events request may cover. Fans
# out to 3 upstream APIs per request, so this bounds per-request Graph/
# Management-API exposure the same way the old (also-removed) Intune-only
# live-Graph audit page capped its own single-source live browsing at 31
# days. Requests omitting startUtc/endUtc default to the trailing 24 hours.
ROLE_ACTIVITY_LIVE_BROWSE_MAX_DAYS=31

# App Intelligence — optional GitHub token (read-only, no scopes needed) to raise the winget-pkgs manifest
# lookup limit from 60 to 5000 requests/hour. Never exposed to the browser.
# GITHUB_TOKEN=

# App Intelligence — optional NVD API key (https://nvd.nist.gov/developers/request-an-api-key). Without it the CVE lookups
# run at NVD's 5-requests-per-30-seconds limit (one call every ~6.5 s, in the background, cached for 24 h); with it, 50.
# NVD_API_KEY=
# Slack channel id for App Inventory "Notify in Slack" messages and the weekly release digest (needs a bot token;
# an incoming webhook posts to its own channel). Jira packaging requests use JIRA_* above.
# SLACK_APP_UPDATE_CHANNEL_ID is already listed above.
