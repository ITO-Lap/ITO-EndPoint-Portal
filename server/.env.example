# Server
PORT=4000

# OpenAI (key format: sk-...)
OPENAI_API_KEY=

# Microsoft Intune (Azure AD App Registration)
INTUNE_TENANT_ID=
INTUNE_CLIENT_ID=
INTUNE_CLIENT_SECRET=

# Microsoft Entra ID (optional — falls back to Intune credentials if not set)
# Requires AuditLog.Read.All, Directory.Read.All, IdentityRiskyUser.Read.All,
# Reports.Read.All on the Azure AD App Registration
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# This app has no per-user login — the Profile page shows real Entra ID +
# Intune data for one fixed identity, looked up by UPN/email via app-only
# Graph credentials. Defaults to avinash.verma@zinnia.com if unset.
PROFILE_USER_UPN=avinash.verma@zinnia.com

# Kandji (URL format: https://<subdomain>.api.kandji.io)
KANDJI_API_URL=
KANDJI_API_TOKEN=

# ManageEngine
MANAGEENGINE_URL=
MANAGEENGINE_API_KEY=

# Slack (api.slack.com/apps — scopes: auditlogs:read, channels:read, users:read — bot token format: xoxb-...)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_WORKSPACE_ID=

# Jira (Atlassian Cloud — Settings → Security → API tokens)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Confluence (optional — defaults to JIRA_BASE_URL if the same Atlassian instance)
CONFLUENCE_BASE_URL=

# ── Intelligence Platform ──────────────────────────────────────────────────────
# PostgreSQL — required for multi-tenant, audit log, and scheduled reports.
# Without this set, those features degrade gracefully; all Intune/AI features still work.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# Initialise schema after setting DATABASE_URL:
#   psql $DATABASE_URL -f server/src/db/schema.sql

# Install export packages (PDF/Excel/PPTX — CSV works without them):
#   cd server && npm install exceljs pdfkit pptxgenjs
#   npm install -D @types/pdfkit @types/node-cron
