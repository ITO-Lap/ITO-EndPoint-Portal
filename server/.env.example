# Server
PORT=4000

# OpenAI
OPENAI_API_KEY=sk-...

# Microsoft Intune (Azure AD App Registration)
INTUNE_TENANT_ID=
INTUNE_CLIENT_ID=
INTUNE_CLIENT_SECRET=

# Microsoft Entra ID (optional — falls back to Intune credentials if not set)
# Requires AuditLog.Read.All, Directory.Read.All, IdentityRiskyUser.Read.All,
# Reports.Read.All on the Azure AD App Registration
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Kandji
KANDJI_API_URL=https://subdomain.api.kandji.io
KANDJI_API_TOKEN=

# ManageEngine
MANAGEENGINE_URL=
MANAGEENGINE_API_KEY=

# Slack (api.slack.com/apps — scopes: auditlogs:read, channels:read, users:read)
SLACK_BOT_TOKEN=xoxb-
SLACK_SIGNING_SECRET=
SLACK_WORKSPACE_ID=

# Jira (Atlassian Cloud — Settings → Security → API tokens)
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=admin@your-org.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=ITO

# Confluence (optional — defaults to JIRA_BASE_URL if the same Atlassian instance)
CONFLUENCE_BASE_URL=
